---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`} aura="contact">
  <section class="mx-auto grid min-h-dvh max-w-6xl items-center gap-10 px-6 py-12 lg:grid-cols-2 lg:gap-12">
    <div class="rise">
      <h1 class="gradient-title text-4xl font-extrabold md:text-5xl">Contact Me</h1>
      <p class="mt-5 mb-8 leading-relaxed text-gray-200">
        Feel free to reach out using the form below. Whether it's a project idea, a question, or just to say hello, I'd
        love to hear from you.
      </p>

      <form id="contact-form" class="space-y-4" data-email={site.email}>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block">
            <span class="sr-only">Name</span>
            <input class="field" type="text" name="name" placeholder="Name" autocomplete="name" required maxlength="100" />
          </label>
          <label class="block">
            <span class="sr-only">Email</span>
            <input class="field" type="email" name="email" placeholder="Email" autocomplete="email" required maxlength="200" />
          </label>
        </div>
        <label class="block">
          <span class="sr-only">Subject</span>
          <input class="field" type="text" name="subject" placeholder="Subject" required maxlength="150" />
        </label>
        <label class="block">
          <span class="sr-only">Message</span>
          <textarea class="field resize-y" name="message" placeholder="Message" rows="5" required maxlength="5000"></textarea>
        </label>
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button type="submit" class="btn btn-mint cursor-pointer disabled:cursor-wait disabled:opacity-60">Send Message</button>
        <p data-status role="status" hidden></p>
      </form>
    </div>

    <div class="rise space-y-4" style="--delay: 150ms">
      <div class="glass p-5">
        <h2 class="text-lg font-bold text-mint">{site.name}</h2>
        <p class="mt-1 text-sm text-gray-200">{site.location}</p>
        <ul class="mt-3 space-y-1 text-sm">
          <li><a class="text-iris underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="text-emerald underline-offset-4 hover:underline" href={site.linkedin} target="_blank" rel="noopener noreferrer">linkedin.com/in/fsucatti</a></li>
          <li><a class="text-accent-soft underline-offset-4 hover:underline" href={site.github} target="_blank" rel="noopener noreferrer">github.com/Fsucatti</a></li>
        </ul>
      </div>
      <iframe
        src={site.mapEmbed}
        title="Map of Buenos Aires"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        class="glass h-72 w-full border-0 [filter:invert(0.9)_hue-rotate(180deg)_saturate(0.8)] lg:h-96"
      ></iframe>
    </div>
  </section>
</BaseLayout>

<script>
  import { setupContactForm } from "../scripts/contact";

  document.addEventListener("astro:page-load", () => {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (form) setupContactForm(form);
  });
</script>
